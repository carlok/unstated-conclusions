# Copy to a local file and `source` it per invocation. Never export these from a
# shell rc: the two directories below belong to other projects, and a stray
# SWEEP_REPO in an interactive shell is how a tool ends up running in the wrong
# corpus.
#
# Neither path is a collaborator. They are Lean installations that already exist
# on this disk, reached by path, and nothing here writes to either of them. The
# only command this project may run inside them is
#
#     lake env lean <file>
#
# where <file> lives in this project's own temp directory. No lake build, no
# lake update, no lake exe cache get, no elan.

# --- Mathlib -----------------------------------------------------------------
# toolchain leanprover/lean4:v4.33.1
# Mathlib pinned at 0df444a360eaa60ab8c11dca51a86af692955474 ("chore: bump
# toolchain to v4.33.1"), which is the revision unused-assumptions published
# against. The per-area correlation is meaningless at any other revision, and
# verify.py refuses to run against one.
export SWEEP_REPO=/path/to/your/lean-project
export SWEEP_IMPORT=Mathlib

# --- TauCeti (Part 2 only; not used in Part 1) -------------------------------
# toolchain leanprover/lean4:v4.34.0-rc1, its own Mathlib pin 4fae4090...
# Its root module is deliberately empty -- the lakefile builds by glob -- so a
# standalone candidate must import the module it came from. header_for() does
# that automatically for any corpus whose root segment is not "Mathlib"; leaving
# SWEEP_IMPORT at "Mathlib" here would resolve nothing and the corpus would
# score as pathologically over-constrained. That failure is on the record in the
# brother's ENGINEERING.md.
#
# export SWEEP_REPO=/path/to/another/corpus
# export SWEEP_IMPORT=Mathlib
